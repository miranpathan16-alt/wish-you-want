@charset "utf-8";

:root { color-scheme: dark; --bg: #090b16; --panel: #121629; --gold: #f6c85f; --muted: #b9bfd1; --line: #2a3048; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: radial-gradient(at 70% 0%, rgb(37, 32, 68) 0px, rgb(9, 11, 22) 48%); color: rgb(255, 255, 255); font: 16px / 1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }

.wrap { width: min(1080px, 92%); margin: auto; }

header { display: flex; justify-content: space-between; align-items: center; padding: 22px 0px; }

.brand { font-weight: 900; letter-spacing: 1px; }

.brand span { color: var(--gold); }

nav a { color: var(--muted); text-decoration: none; margin-left: 22px; font-size: 14px; }

.hero { padding: 65px 0px 75px; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 35px; align-items: center; }

.eyebrow { color: var(--gold); font-weight: 800; letter-spacing: 3px; font-size: 12px; }

.hero h1 { font-size: clamp(42px, 7vw, 76px); line-height: 1.02; margin: 14px 0px; }

.hero h1 em { color: var(--gold); font-style: normal; }

.lead { color: var(--muted); max-width: 550px; font-size: 18px; }

.actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }

.btn { display: inline-block; padding: 13px 22px; border-radius: 12px; text-decoration: none; font-weight: 800; }

.primary { background: linear-gradient(135deg, rgb(255, 224, 139), rgb(217, 155, 43)); color: rgb(23, 18, 10); box-shadow: rgba(217, 155, 43, 0.2) 0px 8px 30px; }

.secondary { border: 1px solid var(--line); color: white; }

.showcase { min-height: 340px; border: 1px solid rgb(57, 52, 81); border-radius: 28px; background: linear-gradient(145deg, rgb(48, 40, 75), rgb(21, 25, 44) 65%, rgb(16, 19, 33)); display: grid; place-items: center; position: relative; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.533) 0px 24px 70px; }

.showcase::before { content: ""; position: absolute; width: 270px; height: 270px; border-radius: 50%; background: rgba(246, 200, 95, 0.133); filter: blur(8px); }

.emoji { position: relative; font-size: clamp(100px, 18vw, 190px); filter: drop-shadow(rgba(0, 0, 0, 0.533) 0px 18px 15px); }

.float { position: absolute; background: rgba(17, 23, 41, 0.867); border: 1px solid rgb(69, 65, 90); padding: 9px 13px; border-radius: 12px; font-size: 13px; }

.f1 { top: 24px; left: 20px; }

.f2 { bottom: 25px; right: 18px; }

.section { padding: 55px 0px; }

.section h2 { font-size: 32px; margin: 0px 0px 8px; }

.sub { color: var(--muted); margin: 0px 0px 25px; }

.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

.card { background: linear-gradient(150deg, rgb(23, 29, 50), rgb(16, 21, 37)); border: 1px solid var(--line); border-radius: 18px; padding: 22px; }

.ico { font-size: 34px; }

.card h3 { margin: 8px 0px 4px; }

.card p { color: var(--muted); margin: 0px; font-size: 14px; }

.how { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }

.step { border-left: 2px solid var(--gold); padding: 8px 16px; }

.step b { color: var(--gold); }

.cta { background: linear-gradient(120deg, rgb(39, 32, 62), rgb(23, 28, 48)); border: 1px solid rgb(71, 64, 93); border-radius: 24px; text-align: center; padding: 42px 20px; }

.cta p { color: var(--muted); }

footer { border-top: 1px solid var(--line); padding: 25px 0px; color: rgb(146, 153, 173); font-size: 13px; margin-top: 55px; }

.disclaimer { font-size: 12px; color: rgb(133, 141, 164); margin-top: 18px; }

@media (max-width: 760px) {
  nav { display: none; }
  .hero { grid-template-columns: 1fr; padding: 38px 0px 50px; }
  .showcase { min-height: 260px; }
  .grid, .how { grid-template-columns: 1fr; }
  .section { padding: 38px 0px; }
}
